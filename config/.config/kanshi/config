output "AOC 24G2W1G4 ATNLB1A010159" {
    mode 1920x1080@144.00
    position 0,0
    scale 1
    alias $MAIN
}

output "Samsung Electric Company S24E650 0x5A5A474D" {
    mode 1920x1080@60.00
    position -1920,0
    scale 1
    transform 180
    alias $LEFT
}

output "Samsung Electric Company S24E650 H4ZJC03052" {
    mode 1920x1080@60.00
    position 1920,-450
    scale 1
    transform 90
    alias $VERTICAL
}

output "Chimei Innolux Corporation 0x14E4" {
    mode 1920x1080
    position 0,0
    scale 0.95
    alias $KARLHEINZ
}

profile desk {
    output $MAIN enable
    output $LEFT enable
    output $VERTICAL enable
    output $KARLHEINZ disable
}

profile karlheinz {
    output $KARLHEINZ enable
}
